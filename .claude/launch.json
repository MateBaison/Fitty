{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@fitty/web",
        "dev",
        "--hostname",
        "localhost",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "mobile",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APP_VARIANT=development",
        "pnpm",
        "--filter",
        "@fitty/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081",
        "--lan"
      ],
      "port": 8081
    }
  ]
}
