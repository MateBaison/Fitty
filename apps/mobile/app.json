{
  "expo": {
    "name": "Fitty",
    "slug": "fitty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitty",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b10",
    "ios": {
      "bundleIdentifier": "uy.fitty.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uy.fitty.app",
      "adaptiveIcon": {
        "backgroundColor": "#052e4f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090b10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitty usa tus fotos para tu perfil, tus entrenamientos y tu progreso corporal.",
          "cameraPermission": "Fitty usa la c\u00e1mara para fotos de perfil, entrenamientos y progreso corporal."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fitty usa tu ubicaci\u00f3n para registrar el recorrido mientras corr\u00e9s o pedale\u00e1s con la app abierta."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
