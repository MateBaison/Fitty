{
  "expo": {
    "name": "Fitty",
    "slug": "fitty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitty",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b10",
    "ios": {
      "bundleIdentifier": "uy.fitty.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["instagram-stories", "instagram"]
      }
    },
    "android": {
      "package": "uy.fitty.app",
      "adaptiveIcon": {
        "backgroundColor": "#052e4f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#052e4f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitty usa tus fotos para tu perfil, tus entrenamientos y tu progreso corporal.",
          "cameraPermission": "Fitty usa la cámara para fotos de perfil, entrenamientos y progreso corporal.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fitty usa tu ubicación para registrar el recorrido mientras corrés o pedaleás con la app abierta."
        }
      ],
      ["expo-audio", { "microphonePermission": false }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e7a6e769-0b13-442c-8090-31feee14c645"
      }
    },
    "owner": "fittyapp"
  }
}
