{
  "expo": {
    "name": "Fitty",
    "slug": "fitty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitty",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b10",
    "ios": {
      "bundleIdentifier": "uy.fitty.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["instagram-stories", "instagram"],
        "NSPhotoLibraryAddUsageDescription": "Fitty saves workout images to your photo library when you choose to save them."
      }
    },
    "android": {
      "package": "uy.fitty.app",
      "adaptiveIcon": {
        "backgroundColor": "#052e4f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#052e4f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitty uses your photos for your profile, workouts and body progress.",
          "cameraPermission": "Fitty uses the camera for your profile, workout and body progress photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e7a6e769-0b13-442c-8090-31feee14c645"
      }
    },
    "owner": "fittyapp",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "hi": "./locales/hi.json",
      "ar": "./locales/ar.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json"
    }
  }
}
